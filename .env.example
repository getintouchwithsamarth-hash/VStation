VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_API_VERSION=2026-01
VITE_STOREFRONT_PUBLIC_URL=https://thevibestation.com
VITE_SHOPIFY_AUTH_HEADER=X-Shopify-Storefront-Access-Token
VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# Market Configuration
VITE_SHOPIFY_COUNTRY_CODE=IN
VITE_SHOPIFY_LANGUAGE_CODE=EN

# Backend API endpoints
VITE_BACKEND_URL=http://localhost:3001

# Storefront API proxy
# Default browser mode: call Shopify Storefront API directly with VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN
# Set this to true only if you explicitly want storefront traffic routed through the backend proxy
VITE_SHOPIFY_STOREFRONT_USE_BACKEND_PROXY=false
VITE_SHOPIFY_STOREFRONT_ENDPOINT=/api/shopify

# Admin API proxy
# Use for: Taxonomy categories, shopify namespace metafields, admin-only data
# Backend uses: SHOPIFY_ADMIN_CLIENT_ID / SHOPIFY_ADMIN_CLIENT_SECRET
# Available in: SSR or client-side for enriched product data
VITE_SHOPIFY_ADMIN_ENDPOINT=/api/shopify/admin

# Optional Shopify bridge page path used with classic /account/login redirect flow.
# Example: /pages/auth-bridge
VITE_SHOPIFY_AUTH_BRIDGE_PATH=/pages/auth-bridge
